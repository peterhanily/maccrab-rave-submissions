#!/usr/bin/env python3
"""Sign an expiring Rave publisher challenge locally; never uploads a private key."""
import argparse
import base64
import hashlib
import json
import time
from pathlib import Path
from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--challenge", required=True, type=Path)
    parser.add_argument("--key", required=True, type=Path, help="Ed25519 private key in unencrypted PEM format")
    args = parser.parse_args()
    try:
        with args.challenge.open("rb") as stream:
            message = stream.read(8193)
        if len(message) > 8192 or not message.startswith(b"MacCrab Rave publisher proof v1\n") or not message.endswith(b"\n"):
            raise ValueError("not a Rave publisher proof challenge")
        fields = json.loads(message.split(b"\n", 1)[1])
        if not isinstance(fields, dict) or not isinstance(fields.get("expires_at"), int) or fields["expires_at"] <= time.time():
            raise ValueError("challenge has expired or is invalid; request another")
        with args.key.open("rb") as stream:
            key_bytes = stream.read(8193)
        if len(key_bytes) > 8192:
            raise ValueError("key file is too large")
        private_key = serialization.load_pem_private_key(key_bytes, password=None)
        if not isinstance(private_key, Ed25519PrivateKey):
            raise ValueError("key must be Ed25519")
        public = private_key.public_key().public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw)
        if hashlib.sha256(public).hexdigest() != fields.get("publisher_key_sha256"):
            raise ValueError("private key does not match this challenge's publisher public key")
        print(base64.b64encode(private_key.sign(message)).decode("ascii"))
    except (OSError, ValueError, TypeError) as exc:
        parser.exit(1, f"error: {exc}\n")


if __name__ == "__main__":
    main()
