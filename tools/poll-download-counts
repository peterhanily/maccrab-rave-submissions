#!/usr/bin/env python3
"""
poll-download-counts — privacy-first popularity (design §5.6, Approach A: zero
client telemetry). For catalog entries whose binary lives in a GitHub release
(community plugins with a source_repo), poll the GitHub Releases API for each
release asset's cumulative download_count and emit SQL that appends a
download_snapshots row and recomputes plugin_popularity.

First-party plugins serve from the rave mirror (no source_repo, no GitHub
release) so they produce NO download signal in v0 — that's expected; the
popularity infra simply shows nothing for them until community plugins land.

NO per-user, per-device, or IP data is ever collected — only public,
aggregate GitHub asset counters.

Usage:
    rave/tools/poll-download-counts --rave-dir rave > poll.sql        # online (needs GH_TOKEN env for rate limit)
    rave/tools/poll-download-counts --rave-dir rave --offline > poll.sql  # skip network; just recompute popularity
    sqlite3 local.db < poll.sql            # local
    wrangler d1 execute maccrab-rave --file=poll.sql   # production
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.request
from pathlib import Path


def q(v):
    if v is None:
        return "NULL"
    if isinstance(v, int):
        return str(v)
    return "'" + str(v).replace("'", "''") + "'"


def _gh_get(url: str, token: str | None):
    """GET a GitHub API URL; return (json, next_page_url_or_None, ratelimit_remaining)."""
    req = urllib.request.Request(url, headers={
        "User-Agent": "maccrab-rave-poller",
        "Accept": "application/vnd.github+json",
        **({"Authorization": f"Bearer {token}"} if token else {}),
    })
    resp = urllib.request.urlopen(req, timeout=15)
    remaining = resp.headers.get("X-RateLimit-Remaining")
    next_url = None
    for part in (resp.headers.get("Link") or "").split(","):
        if 'rel="next"' in part and "<" in part and ">" in part:
            next_url = part[part.find("<") + 1:part.find(">")]
    return json.load(resp), next_url, remaining


def github_release_downloads(owner_repo: str, tag: str, token: str | None):
    """Sum download_count across ALL assets of a release tag (paginated — GitHub
    caps assets at 30/page), or None on failure. Backs off when the rate limit
    is nearly exhausted (the installation token's 5000/h is shared with PR work)."""
    try:
        rel, _, remaining = _gh_get(f"https://api.github.com/repos/{owner_repo}/releases/tags/{tag}", token)
    except Exception as e:  # noqa: BLE001 — network/rate-limit/404 are all "no signal"
        print(f"-- poll: {owner_repo}@{tag} unavailable ({e})", file=sys.stderr)
        return None
    total = 0
    url = (rel.get("assets_url") or "") + "?per_page=100"
    while url:
        try:
            assets, next_url, remaining = _gh_get(url, token)
        except Exception as e:  # noqa: BLE001
            print(f"-- poll: {owner_repo}@{tag} asset page failed ({e})", file=sys.stderr)
            return total
        total += sum(int(a.get("download_count", 0)) for a in assets)
        if remaining and remaining.isdigit() and int(remaining) < 10:
            print(f"-- poll: GitHub rate limit low ({remaining}) — stopping pagination", file=sys.stderr)
            break
        url = next_url
    return total


def repo_from_source(source_repo: str) -> str | None:
    if not source_repo:
        return None
    s = source_repo.rstrip("/")
    if "github.com/" not in s:
        return None
    return s.split("github.com/", 1)[1].removesuffix(".git")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--rave-dir", default=str(Path(__file__).resolve().parent.parent))
    ap.add_argument("--offline", action="store_true", help="skip network; only recompute popularity from existing snapshots")
    args = ap.parse_args()
    rave = Path(args.rave_dir).resolve()
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")

    out = ["-- generated by poll-download-counts; do not edit by hand", "BEGIN;"]
    polled = skipped = 0

    if not args.offline:
        for f in sorted((rave / "catalog").glob("*.json")):
            e = json.loads(f.read_text())
            repo = repo_from_source(e.get("source_repo", ""))
            ver = e.get("current_version")
            tag = ((e.get("versions") or {}).get(ver) or {}).get("tag")
            if not repo or not tag:
                skipped += 1  # first-party / mirror-hosted: no GitHub download signal
                continue
            count = github_release_downloads(repo, tag, token)
            if count is None:
                skipped += 1
                continue
            out.append(
                "INSERT INTO download_snapshots (plugin_id, version, snapshot_at, download_count) "
                f"VALUES ({q(e['id'])}, {q(ver)}, unixepoch(), {count});"
            )
            polled += 1

    # Recompute plugin_popularity from snapshots (latest cumulative = total;
    # 30d delta = latest - oldest snapshot within 30 days). Pure SQL; safe to
    # run even with zero snapshots (popularity simply stays empty/0).
    out.append("""DELETE FROM plugin_popularity;
INSERT INTO plugin_popularity (plugin_id, total_downloads, downloads_30d, computed_at)
SELECT s.plugin_id,
       SUM(s.latest) AS total_downloads,
       SUM(s.latest - s.base_30d) AS downloads_30d,
       unixepoch()
FROM (
  SELECT plugin_id, version,
    (SELECT download_count FROM download_snapshots d2
      WHERE d2.plugin_id=d1.plugin_id AND d2.version=d1.version
      ORDER BY snapshot_at DESC LIMIT 1) AS latest,
    (SELECT download_count FROM download_snapshots d3
      WHERE d3.plugin_id=d1.plugin_id AND d3.version=d1.version
        AND d3.snapshot_at >= unixepoch() - 2592000
      ORDER BY snapshot_at ASC LIMIT 1) AS base_30d
  FROM download_snapshots d1
  GROUP BY plugin_id, version
) s
GROUP BY s.plugin_id;""")
    # rank by total_downloads (1 = most)
    out.append("""UPDATE plugin_popularity SET rank = (
  SELECT COUNT(*)+1 FROM plugin_popularity p2
  WHERE p2.total_downloads > plugin_popularity.total_downloads);""")

    # Prune snapshots older than 90d once materialized (design §2.3).
    out.append("DELETE FROM download_snapshots WHERE snapshot_at < unixepoch() - 7776000;")

    out.append("COMMIT;")
    print("\n".join(out))
    print(f"-- polled {polled} GitHub-hosted plugins, skipped {skipped} (no GitHub release signal)", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
