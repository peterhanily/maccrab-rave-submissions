#!/usr/bin/env python3
"""Require community drafts to name one immutable source revision in every stage."""
import argparse
import json
import re
from pathlib import Path


def validate(entry):
    if entry.get("channel") != "contrib":
        return
    version = entry.get("current_version")
    source = entry.get("versions", {}).get(version, {}).get("source_commit", "")
    if not re.fullmatch(r"[a-f0-9]{40}", source) or source == "0" * 40:
        raise ValueError("source_commit must be resolved before opening the PR")
    if entry.get("approved_at_commit") != source:
        raise ValueError("entry and version must pin the same source commit")
    if entry.get("kind") != "collector":
        raise ValueError("external analyzer dispatch is not qualified")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--catalog", type=Path, default=Path("catalog"))
    args = parser.parse_args()
    entries = sorted(args.catalog.glob("*.json"))
    if not entries:
        parser.exit(1, "error: no catalog entries to validate\n")
    for path in entries:
        try:
            validate(json.loads(path.read_text()))
        except (ValueError, TypeError) as exc:
            parser.exit(1, f"error: {path}: {exc}\n")
    print(f"checked immutable submission pins in {len(entries)} entries")
