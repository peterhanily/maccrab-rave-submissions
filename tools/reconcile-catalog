#!/usr/bin/env python3
"""
reconcile-catalog — emit idempotent SQL that mirrors the signed static catalog
into the D1 CACHE tables (plugins, plugin_tags, plugin_versions, kits,
kit_plugins, revocations). One-way: catalog -> D1. Signed bytes are authority;
this never writes back to the catalog and never touches AUTH tables
(submissions, users, counters, screenshots, featured, reports, is_listed).

Runs the publication trust gate (verify-catalog-signatures) FIRST and refuses
to emit anything if a signature is missing/invalid — so an unsigned entry never
reaches the browse cache, exactly as it never reaches the served bytes.

Usage:
    rave/tools/reconcile-catalog --rave-dir rave > reconcile.sql
    sqlite3 local.db < reconcile.sql                       # local test
    wrangler d1 execute maccrab-rave --file=reconcile.sql  # production
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
from pathlib import Path


def q(v):
    """SQL-quote a value: NULL, integer, or single-quoted escaped string."""
    if v is None:
        return "NULL"
    if isinstance(v, bool):
        return "1" if v else "0"
    if isinstance(v, int):
        return str(v)
    return "'" + str(v).replace("'", "''") + "'"


def sha256_hex(p: Path) -> str:
    return hashlib.sha256(p.read_bytes()).hexdigest()


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--rave-dir", default=str(Path(__file__).resolve().parent.parent))
    ap.add_argument("--skip-verify", action="store_true",
                    help="skip the signature gate (TEST ONLY; never in production)")
    args = ap.parse_args()
    rave = Path(args.rave_dir).resolve()

    # Publication trust gate — refuse to mirror anything unsigned.
    if not args.skip_verify:
        verifier = Path(__file__).resolve().parent / "verify-catalog-signatures"
        # Capture the verifier's output to stderr so ONLY SQL reaches our stdout.
        r = subprocess.run([sys.executable, str(verifier), "--rave-dir", str(rave)],
                           capture_output=True, text=True)
        sys.stderr.write(r.stdout + r.stderr)
        if r.returncode != 0:
            print("-- reconcile aborted: signature gate failed", file=sys.stderr)
            return 1

    # No BEGIN/COMMIT: D1's `wrangler d1 execute --file` rejects explicit SQL
    # transactions and applies the file's statements as one atomic batch.
    out = ["-- generated by reconcile-catalog; do not edit by hand",
           "PRAGMA foreign_keys = ON;"]

    # ---- plugins (+ tags + versions) ----
    plugin_ids = []
    for f in sorted((rave / "catalog").glob("*.json")):
        e = json.loads(f.read_text())
        pid = e["id"]
        plugin_ids.append(pid)
        src = sha256_hex(f)
        meta = e.get("metadata", {})
        cols = {
            "id": pid,
            "display_name": e.get("display_name"),
            "short_description": e.get("short_description"),
            "category": meta.get("category"),
            "channel": e.get("channel"),
            "runtime": e.get("runtime"),
            "trust_tier": e.get("trust_tier"),
            "kind": e.get("kind"),
            "privacy_class": e.get("privacy_class"),
            "status": e.get("status", "active"),
            "current_version": e.get("current_version"),
            "signer_identity": e.get("signer_identity"),
            "signer_public_key_sha256": e.get("signer_public_key_sha256"),
            "source_repo": e.get("source_repo"),
            "source_owner": e.get("source_owner"),
            "icon_path": e.get("icon"),
            "approved_at": e.get("approved_at"),
            "catalog_source_sha256": src,
        }
        names = list(cols.keys()) + ["catalog_synced_at"]
        vals = [q(cols[k]) for k in cols] + ["unixepoch()"]
        # is_listed is AUTH — never set/overwritten by reconcile.
        upd = ", ".join(f"{k}=excluded.{k}" for k in cols if k != "id") + ", catalog_synced_at=excluded.catalog_synced_at"
        out.append(
            f"INSERT INTO plugins ({', '.join(names)}) VALUES ({', '.join(vals)}) "
            f"ON CONFLICT(id) DO UPDATE SET {upd};"
        )
        out.append(f"DELETE FROM plugin_tags WHERE plugin_id={q(pid)};")
        for tag in meta.get("tags", []) or []:
            out.append(f"INSERT INTO plugin_tags (plugin_id, tag) VALUES ({q(pid)}, {q(tag)});")
        out.append(f"DELETE FROM plugin_versions WHERE plugin_id={q(pid)};")
        for ver, vd in (e.get("versions") or {}).items():
            vet = vd.get("vetting", {}) or {}
            out.append(
                "INSERT INTO plugin_versions (plugin_id, version, tag, source_commit, "
                "artifact_sha256, canonical_tree_sha256, manifest_sha256, signature_sha256, "
                "reproducibility, vetted_at, vetting_policy_commit) VALUES ("
                f"{q(pid)}, {q(ver)}, {q(vd.get('tag'))}, {q(vd.get('source_commit'))}, "
                f"{q(vd.get('artifact_sha256'))}, {q(vd.get('canonical_tree_sha256'))}, "
                f"{q(vd.get('manifest_sha256'))}, {q(vd.get('signature_sha256'))}, "
                f"{q(vd.get('reproducibility'))}, {q(vet.get('vetted_at'))}, {q(vet.get('vetting_policy_commit'))});"
            )

    # ---- kits (+ kit_plugins) ----
    kit_ids = []
    for f in sorted((rave / "kits").glob("*.json")):
        k = json.loads(f.read_text())
        kid = k["id"]
        kit_ids.append(kid)
        src = sha256_hex(f)
        maintainer = "MacCrab" if k.get("maintainer") in ("peterhanily",) else k.get("maintainer")
        cols = {
            "id": kid, "name": k.get("name"), "description": k.get("description"),
            "version": k.get("version"), "maintainer": maintainer,
            "category": k.get("category"), "trust_tier": k.get("trust_tier"),
            "catalog_source_sha256": src,
        }
        names = list(cols.keys()) + ["catalog_synced_at"]
        vals = [q(cols[c]) for c in cols] + ["unixepoch()"]
        upd = ", ".join(f"{c}=excluded.{c}" for c in cols if c != "id") + ", catalog_synced_at=excluded.catalog_synced_at"
        out.append(
            f"INSERT INTO kits ({', '.join(names)}) VALUES ({', '.join(vals)}) "
            f"ON CONFLICT(id) DO UPDATE SET {upd};"
        )
        out.append(f"DELETE FROM kit_plugins WHERE kit_id={q(kid)};")
        for i, p in enumerate(k.get("plugins", []) or []):
            if isinstance(p, str):
                p = {"plugin_id": p, "min_version": "0.0.0"}
            out.append(
                "INSERT INTO kit_plugins (kit_id, plugin_id, min_version, role, required, ord) VALUES ("
                f"{q(kid)}, {q(p.get('plugin_id'))}, {q(p.get('min_version', '0.0.0'))}, "
                f"{q(p.get('role'))}, {q(bool(p.get('required', True)))}, {i});"
            )

    # ---- revocations mirror (replace-all; signed file is authority) ----
    rev_path = rave / "revocations.json"
    if rev_path.exists():
        rev = json.loads(rev_path.read_text())
        out.append("DELETE FROM revocations;")
        for r in rev.get("revocations", []) or []:
            # Map the signed nested scope{} -> the flat D1 cache columns.
            scope = r.get("scope") or {}
            kind = scope.get("kind")
            from_v = scope.get("version") if kind == "single_version" else scope.get("from_version")
            to_v = scope.get("to_version")
            out.append(
                "INSERT INTO revocations (plugin_id, scope_kind, from_version, to_version, code, "
                "reason, advisory_url, decided_at, decided_by, catalog_synced_at) VALUES ("
                f"{q(r.get('plugin_id'))}, {q(kind)}, {q(from_v)}, "
                f"{q(to_v)}, {q(r.get('code'))}, {q(r.get('reason'))}, "
                f"{q(r.get('advisory_url'))}, {q(r.get('decided_at'))}, "
                f"{q(json.dumps(r.get('decided_by', [])))}, unixepoch());"
            )

    # ---- archive entries that vanished from the signed set (never delete) ----
    if plugin_ids:
        keep = ", ".join(q(i) for i in plugin_ids)
        out.append(f"UPDATE plugins SET status='archived', catalog_synced_at=unixepoch() "
                   f"WHERE id NOT IN ({keep}) AND status != 'archived';")
    if kit_ids:
        keep = ", ".join(q(i) for i in kit_ids)
        out.append(f"UPDATE kits SET is_listed=0 WHERE id NOT IN ({keep});")

    print("\n".join(out))
    print(f"-- reconciled {len(plugin_ids)} plugins, {len(kit_ids)} kits", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
